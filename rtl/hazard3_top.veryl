// Hazard3's RVFI port outside riscv-formal: the core reports each
// instruction it retires, for the harness trace.
include (inline, "hazard3_rvfi.v");

// Hazard3, flattened by scripts/flatten.py
include (inline, "hazard3.v");

/// Runs Hazard3 (`hazard3_cpu_1port`, RV32IMAC, with Zbb, Zifencei and the
/// cycle and instret counters) from an FPGA memory and DRAM.
///
/// The core has one AHB port for fetches, loads and stores. Its addresses are
/// split: the 64 KB from `BASE` (the reset vector) go to a block RAM port
/// with a read latency of one cycle (`tcm`), and everything above goes through
/// `hns::ahb2axi` to an AXI4 port on the board's DRAM (`dmem`). Each address
/// is in one memory only, so a store is seen by fetches.
///
/// A timer answers at `CLINT`, laid out as the usual CLINT (and QEMU's virt
/// machine): `msip` at +0x0, `mtimecmp` at +0x4000, `mtime` at +0xbff8.
/// `mtime` counts the core clock, and stops while the hart is halted for the
/// debugger, as in Hazard3's example SoC. It drives the timer and software
/// interrupts.
///
/// The Debug Module (`hazard3_dm`) is reached on its DMI, an APB slave the
/// harness drives. It runs on its own reset, which `hio reset` does not
/// touch, so a halted hart and a halt-on-reset request survive it. The core
/// is reset by the DUT reset or by the Debug Module (`ndmreset`), as in
/// Hazard3's example SoC.
///
/// The external interrupt and power control are not used; they are tied off.
module hazard3_top (
    i_clk   : input clock          ,
    i_rst   : input reset_async_low,
    i_dm_rst: input reset_async_low,

    i_dmi_psel   : input  logic    ,
    i_dmi_penable: input  logic    ,
    i_dmi_pwrite : input  logic    ,
    i_dmi_paddr  : input  logic<9> ,
    i_dmi_pwdata : input  logic<32>,
    o_dmi_prdata : output logic<32>,
    o_dmi_pready : output logic    ,

    o_tcm_addr : output logic<32>,
    o_tcm_re   : output logic    ,
    o_tcm_we   : output logic    ,
    o_tcm_wstrb: output logic<4> ,
    o_tcm_wdata: output logic<32>,
    i_tcm_rdata: input  logic<32>,

    // Each retired instruction (RVFI), for `backing = "trace"`.
    o_rvfi_valid    : output logic    ,
    o_rvfi_pc_rdata : output logic<32>,
    o_rvfi_pc_wdata : output logic<32>,
    o_rvfi_insn     : output logic<32>,
    o_rvfi_trap     : output logic    ,
    o_rvfi_intr     : output logic    ,
    o_rvfi_mode     : output logic<2> ,
    o_rvfi_rd_addr  : output logic<5> ,
    o_rvfi_rd_wdata : output logic<32>,
    o_rvfi_mem_addr : output logic<32>,
    o_rvfi_mem_rmask: output logic<4> ,
    o_rvfi_mem_wmask: output logic<4> ,
    o_rvfi_mem_rdata: output logic<32>,
    o_rvfi_mem_wdata: output logic<32>,

    // The core's own addresses. `dut_base` in Harness.toml places the DRAM
    // at TCM_END, and the harness refuses what falls outside it.
    dmem: modport $std::axi4_if::<$std::axi4_pkg::<32, 4, 1, 1, 1, 1, 1, 1>>::master,
) {
    const BASE     : bit<32> = 32'h8000_0000;
    const TCM_END  : bit<32> = 32'h8001_0000;
    const CLINT    : bit<32> = 32'h0200_0000;
    const CLINT_END: bit<32> = 32'h0201_0000;

    // The core's AHB port.
    var haddr : logic<32>;
    var hwrite: logic    ;
    var htrans: logic<2> ;
    var hsize : logic<3> ;
    var hwdata: logic<32>;
    var hready: logic    ;
    var hrdata: logic<32>;

    // The DRAM side of the split.
    var d_htrans: logic<2> ;
    var d_hready: logic    ;
    var d_hrdata: logic<32>;

    // The timer side, and the timer.
    var c_sel   : logic    ; // the address phase is for the timer
    var c_data  : logic    ; // the data phase is the timer's
    var c_wr    : logic    ; // ... and is a write
    var c_addr  : logic<16>;
    var c_wstrb : logic<4> ;
    var c_rdata : logic<32>;
    var msip    : logic    ;
    var mtime   : logic<64>;
    var mtimecmp: logic<64>;
    var mtip    : logic    ;

    var pwrup_req  : logic;
    var unblock_out: logic;

    // Between the Debug Module and the core.
    var sys_reset_req   : logic    ;
    var hart_reset_req  : logic    ;
    var req_halt        : logic    ;
    var req_halt_reset  : logic    ;
    var req_resume      : logic    ;
    var halted          : logic    ;
    var running         : logic    ;
    var data0_rdata     : logic<32>;
    var data0_wdata     : logic<32>;
    var data0_wen       : logic    ;
    var instr_data      : logic<32>;
    var instr_data_vld  : logic    ;
    var instr_data_rdy  : logic    ;
    var caught_exception: logic    ;
    var caught_ebreak   : logic    ;

    // The core's reset: the DUT reset, or a reset the Debug Module asks for.
    // A request is a pulse of at least one cycle, so sampling it is enough.
    var cpu_rst_meta: logic;
    var cpu_rst_n   : logic;

    always_ff (i_clk, i_rst) {
        if_reset {
            cpu_rst_meta = 0;
            cpu_rst_n    = 0;
        } else {
            cpu_rst_meta = !sys_reset_req && !hart_reset_req;
            cpu_rst_n    = cpu_rst_meta;
        }
    }

    inst u_dm: $sv::hazard3_dm #(
        N_HARTS     : 1,
        HAVE_SBA    : 0,
        NEXT_DM_ADDR: 0,
    ) (
        clk                        : i_clk           ,
        rst_n                      : i_dm_rst        ,
        dmi_psel                   : i_dmi_psel      ,
        dmi_penable                : i_dmi_penable   ,
        dmi_pwrite                 : i_dmi_pwrite    ,
        dmi_paddr                  : i_dmi_paddr     ,
        dmi_pwdata                 : i_dmi_pwdata    ,
        dmi_prdata                 : o_dmi_prdata    ,
        dmi_pready                 : o_dmi_pready    ,
        dmi_pslverr                : _               ,
        sys_reset_req                                ,
        sys_reset_done             : cpu_rst_n       ,
        hart_reset_req                               ,
        hart_reset_done            : cpu_rst_n       ,
        hart_req_halt              : req_halt        ,
        hart_req_halt_on_reset     : req_halt_reset  ,
        hart_req_resume            : req_resume      ,
        hart_halted                : halted          ,
        hart_running               : running         ,
        hart_data0_rdata           : data0_rdata     ,
        hart_data0_wdata           : data0_wdata     ,
        hart_data0_wen             : data0_wen       ,
        hart_instr_data            : instr_data      ,
        hart_instr_data_vld        : instr_data_vld  ,
        hart_instr_data_rdy        : instr_data_rdy  ,
        hart_instr_caught_exception: caught_exception,
        hart_instr_caught_ebreak   : caught_ebreak   ,
        sbus_addr                  : _               ,
        sbus_write                 : _               ,
        sbus_size                  : _               ,
        sbus_vld                   : _               ,
        sbus_rdy                   : '0              ,
        sbus_err                   : '0              ,
        sbus_wdata                 : _               ,
        sbus_rdata                 : '0              ,
    );

    inst u_cpu: $sv::hazard3_cpu_1port #(
        RESET_VECTOR       : BASE,
        MTVEC_INIT         : BASE,
        DEBUG_SUPPORT      : 1   ,
        BREAKPOINT_TRIGGERS: 2   ,
        CSR_COUNTER        : 1   ,
        EXTENSION_ZBB      : 1   ,
        EXTENSION_ZIFENCEI : 1   ,
    ) (
        clk          : i_clk      ,
        clk_always_on: i_clk      ,
        rst_n        : cpu_rst_n  ,
        pwrup_req                 ,
        pwrup_ack    : pwrup_req  ,
        clk_en       : _          ,
        unblock_out               ,
        unblock_in   : unblock_out,

        haddr        ,
        hwrite       ,
        htrans       ,
        hsize        ,
        hburst   : _ ,
        hprot    : _ ,
        hmastlock: _ ,
        hmaster  : _ ,
        hexcl    : _ ,
        hready       ,
        hresp    : '0,
        hexokay  : '1, // a single master: no global monitor
        hwdata       ,
        hrdata       ,

        fence_i_vld: _ ,
        fence_d_vld: _ ,
        fence_rdy  : '1,

        dbg_req_halt              : req_halt        ,
        dbg_req_halt_on_reset     : req_halt_reset  ,
        dbg_req_resume            : req_resume      ,
        dbg_halted                : halted          ,
        dbg_running               : running         ,
        dbg_data0_rdata           : data0_rdata     ,
        dbg_data0_wdata           : data0_wdata     ,
        dbg_data0_wen             : data0_wen       ,
        dbg_instr_data            : instr_data      ,
        dbg_instr_data_vld        : instr_data_vld  ,
        dbg_instr_data_rdy        : instr_data_rdy  ,
        dbg_instr_caught_exception: caught_exception,
        dbg_instr_caught_ebreak   : caught_ebreak   ,
        dbg_sbus_addr             : '0              ,
        dbg_sbus_write            : '0              ,
        dbg_sbus_size             : '0              ,
        dbg_sbus_vld              : '0              ,
        dbg_sbus_rdy              : _               ,
        dbg_sbus_err              : _               ,
        dbg_sbus_wdata            : '0              ,
        dbg_sbus_rdata            : _               ,

        mhartid_val: '0  ,
        eco_version: '0  ,
        irq        : '0  ,
        soft_irq   : msip,
        timer_irq  : mtip,

        rvfi_valid    : o_rvfi_valid    ,
        rvfi_pc_rdata : o_rvfi_pc_rdata ,
        rvfi_pc_wdata : o_rvfi_pc_wdata ,
        rvfi_insn     : o_rvfi_insn     ,
        rvfi_trap     : o_rvfi_trap     ,
        rvfi_intr     : o_rvfi_intr     ,
        rvfi_mode     : o_rvfi_mode     ,
        rvfi_rd_addr  : o_rvfi_rd_addr  ,
        rvfi_rd_wdata : o_rvfi_rd_wdata ,
        rvfi_mem_addr : o_rvfi_mem_addr ,
        rvfi_mem_rmask: o_rvfi_mem_rmask,
        rvfi_mem_wmask: o_rvfi_mem_wmask,
        rvfi_mem_rdata: o_rvfi_mem_rdata,
        rvfi_mem_wdata: o_rvfi_mem_wdata,
    );

    // The split. `t_` is the block RAM side. A read there answers in its
    // data phase, the cycle after the address. A write takes its data in the
    // data phase and writes then; a block RAM read whose address comes in that
    // same cycle waits one cycle, since the port has one address.
    var t_sel    : logic    ; // the address phase is for the block RAM
    var accept   : logic    ; // an address phase is taken this cycle
    var t_data   : logic    ; // the data phase is the block RAM's
    var t_wr     : logic    ; // ... and is a write
    var t_written: logic    ; // ... already written, while a read waits
    var t_waddr  : logic<32>;
    var t_wstrb  : logic<4> ;
    var t_ready  : logic    ;
    var t_writing: logic    ;

    always_comb {
        t_sel     = haddr >= BASE && haddr <: TCM_END;
        c_sel     = haddr >= CLINT && haddr <: CLINT_END;
        t_writing = t_data && t_wr && !t_written;
        t_ready   = !(t_writing && htrans[1] && !hwrite && t_sel);
        hready    = if t_data ? t_ready : if c_data ? 1'b1 : d_hready;
        hrdata    = if t_data ? i_tcm_rdata : if c_data ? c_rdata : d_hrdata;
        accept    = hready && htrans[1];

        o_tcm_we    = t_writing;
        o_tcm_wstrb = t_wstrb;
        o_tcm_wdata = hwdata;
        o_tcm_re    = !t_writing && accept && t_sel && !hwrite;
        o_tcm_addr  = if t_writing ? t_waddr : haddr;

        d_htrans = if accept && !t_sel && !c_sel ? htrans : 2'b00;
    }

    always_ff (i_clk, i_rst) {
        if_reset {
            t_data    = 0;
            t_wr      = 0;
            t_written = 0;
            t_waddr   = 0;
            t_wstrb   = 0;
        } else if hready {
            t_data    = accept && t_sel;
            t_wr      = hwrite;
            t_written = 0;
            t_waddr   = haddr;
            t_wstrb   = strobe(hsize, haddr[1:0]);
        } else if t_writing {
            t_written = 1;
        }
    }

    // The timer. Its data phase answers at once: a read from the registers,
    // a write into them.
    always_comb {
        case c_addr {
            16'h0000: c_rdata = {31'b0, msip};
            16'h4000: c_rdata = mtimecmp[31:0];
            16'h4004: c_rdata = mtimecmp[63:32];
            16'hbff8: c_rdata = mtime[31:0];
            16'hbffc: c_rdata = mtime[63:32];
            default : c_rdata = 0;
        }
    }

    always_ff (i_clk, i_rst) {
        if_reset {
            c_data   = 0;
            c_wr     = 0;
            c_addr   = 0;
            c_wstrb  = 0;
            msip     = 0;
            mtime    = 0;
            mtimecmp = '1;
            mtip     = 0;
        } else {
            if hready {
                c_data  = accept && c_sel;
                c_wr    = hwrite;
                c_addr  = {haddr[15:2], 2'b00};
                c_wstrb = strobe(hsize, haddr[1:0]);
            }
            if c_data && c_wr && c_addr == 16'hbff8 {
                mtime[31:0] = merge(mtime[31:0], hwdata, c_wstrb);
            } else if c_data && c_wr && c_addr == 16'hbffc {
                mtime[63:32] = merge(mtime[63:32], hwdata, c_wstrb);
            } else if !halted {
                mtime += 1;
            }
            if c_data && c_wr && c_addr == 16'h4000 {
                mtimecmp[31:0] = merge(mtimecmp[31:0], hwdata, c_wstrb);
            }
            if c_data && c_wr && c_addr == 16'h4004 {
                mtimecmp[63:32] = merge(mtimecmp[63:32], hwdata, c_wstrb);
            }
            if c_data && c_wr && c_addr == 16'h0000 && c_wstrb[0] {
                msip = hwdata[0];
            }
            mtip = mtime >= mtimecmp;
        }
    }

    // A write of `wdata` over `word`, where its byte strobes are set.
    function merge (
        word : input logic<32>,
        wdata: input logic<32>,
        strb : input logic<4> ,
    ) -> logic<32> {
        var out: logic<32>;
        for i in 0..4 {
            out[i * 8+:8] = if strb[i] ? wdata[i * 8+:8] : word[i * 8+:8];
        }
        return out;
    }

    function strobe (
        size: input logic<3>,
        addr: input logic<2>,
    ) -> logic<4> {
        case size {
            0      : return 4'b0001 << addr;
            1      : return 4'b0011 << {addr[1], 1'b0};
            default: return 4'b1111;
        }
    }

    inst u_d2axi: hns::ahb2axi::<$std::axi4_pkg::<32, 4, 1, 1, 1, 1, 1, 1>> (
        i_clk             ,
        i_rst             ,
        i_haddr : haddr   ,
        i_hwrite: hwrite  ,
        i_htrans: d_htrans,
        i_hsize : hsize   ,
        i_hwdata: hwdata  ,
        o_hready: d_hready,
        o_hrdata: d_hrdata,
        axi     : dmem    ,
    );
}
