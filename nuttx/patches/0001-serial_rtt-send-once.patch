 };
 
 /****************************************************************************
@@ -361,10 +363,32 @@ static void serial_rtt_dmarxfree(FAR struct uart_dev_s *dev)
 
 static void serial_rtt_dmatxavail(FAR struct uart_dev_s *dev)
 {
+  FAR struct serial_rtt_s *rtt = dev->priv;
+  irqstate_t flags;
+
+  /* Both the writer and the polling timer come here, and the timer runs in
+   * interrupt context. A timer that fires between the RTT write and the
+   * tail update would send the same bytes again, so it leaves a send in
+   * progress alone. Interrupts are not kept off for the send itself: it
+   * may block until the host reads.
+   */
+
+  flags = enter_critical_section();
+  if (rtt->txbusy)
+    {
+      leave_critical_section(flags);
+      return;
+    }
+
+  rtt->txbusy = true;
+  leave_critical_section(flags);
+
   if (serial_rtt_txready(dev))
     {
       uart_xmitchars_dma(dev);
     }
+
+  rtt->txbusy = false;
 }
 
 /****************************************************************************
