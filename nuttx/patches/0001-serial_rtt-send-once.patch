--- a/drivers/segger/serial_rtt.c
+++ b/drivers/segger/serial_rtt.c
@@ -28,6 +28,7 @@
 #include <sys/types.h>
 #include <syslog.h>
 
+#include <nuttx/irq.h>
 #include <nuttx/kmalloc.h>
 #include <nuttx/segger/rtt.h>
 #include <nuttx/serial/serial.h>
@@ -56,6 +57,7 @@ struct serial_rtt_s
   int channel;
   FAR char *up_buffer;
   FAR char *down_buffer;
